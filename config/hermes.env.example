# EN: Lines this installation adds to ~/.hermes/.env
#     Don't replace the whole file: it already holds the OpenRouter API key and
#     other values created by "hermes setup". Add or edit only these lines.
#     Each variable must appear only once.
#
# ES: Líneas que esta instalación añade a ~/.hermes/.env
#     No sustituyas el archivo completo: ya contiene la API key de OpenRouter y
#     otros valores que crea "hermes setup". Añade o modifica solo estas líneas.
#     Cada variable debe aparecer una sola vez.

# EN: Obsidian vault path (part 4) / ES: Ruta del vault de Obsidian (parte 4)
OBSIDIAN_VAULT_PATH=/home/hermes/vault/<vault-name>

# EN: Hermes API server for Hermes Workspace (part 6)
# ES: Servidor API de Hermes para Hermes Workspace (parte 6)
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642

# EN: Generate with: openssl rand -hex 32. Grants full control over Hermes
#     (terminal included). Never publish it.
# ES: Genérala con: openssl rand -hex 32. Da control total sobre Hermes
#     (incluida la terminal). Nunca la publiques.
API_SERVER_KEY=<generated-key>
