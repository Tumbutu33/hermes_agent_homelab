# EN: Lines this installation appends to ~/hermes-workspace/.env
#     (after: cp .env.example .env)
#     Also comment out the two VITE_PLAYGROUND_* lines of the original .env:
#
# ES: Líneas que esta instalación añade al final de ~/hermes-workspace/.env
#     (después de: cp .env.example .env)
#     Además, comenta las dos líneas VITE_PLAYGROUND_* del .env original:
#
#   sed -i 's/^VITE_PLAYGROUND/# VITE_PLAYGROUND/' ~/hermes-workspace/.env

HERMES_API_URL=http://127.0.0.1:8642
HERMES_DASHBOARD_URL=http://127.0.0.1:9119

# EN: Must be identical to API_SERVER_KEY in ~/.hermes/.env
# ES: Debe ser idéntica a API_SERVER_KEY de ~/.hermes/.env
HERMES_API_TOKEN=<same-value-as-API_SERVER_KEY>

# EN: Password to log in to the interface. Different from the hermes user's password.
#     Generate with: openssl rand -hex 24
# ES: Contraseña para entrar a la interfaz. Distinta de la del usuario hermes.
#     Genérala con: openssl rand -hex 24
HERMES_PASSWORD=<interface-password>

# EN: Tailscale Serve acts as an HTTPS proxy in front of Workspace
# ES: Tailscale Serve actúa como proxy HTTPS delante de Workspace
TRUST_PROXY=1

# EN: Hides the HermesWorld multiplayer feature (run pnpm build again if changed)
# ES: Oculta la función multijugador HermesWorld (repetir pnpm build si se cambia)
VITE_HERMESWORLD_ENABLED=0
